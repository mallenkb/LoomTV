{
  "name": "@loom-media-server/mobile",
  "version": "1.0.1",
  "license": "MIT",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@loom-media-server/lan-protocol": "workspace:*",
    "expo": "58.0.16",
    "expo-blur": "58.0.5",
    "expo-brightness": "58.0.2",
    "expo-build-properties": "58.0.11",
    "expo-dev-client": "58.0.14",
    "expo-device": "58.0.5",
    "expo-file-system": "58.0.10",
    "expo-image": "58.0.16",
    "expo-screen-orientation": "58.0.3",
    "expo-secure-store": "58.0.2",
    "expo-sqlite": "58.0.13",
    "expo-status-bar": "58.0.3",
    "expo-video": "58.0.12",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-zeroconf": "0.17.6",
    "zod": "catalog:",
    "expo-system-ui": "58.0.6",
    "expo-font": "58.0.9"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "preandroid": "expo prebuild --platform android --no-install",
    "android": "node scripts/run-android.cjs",
    "preios": "expo prebuild --platform ios --no-install",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:development:android": "eas build --platform android --profile development",
    "build:development:ios": "eas build --platform ios --profile development",
    "build:development:simulator:ios": "eas build --platform ios --profile development-simulator",
    "build:preview:android": "eas build --platform android --profile preview",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "build:simulator:ios": "eas build --platform ios --profile preview-simulator",
    "build:production": "eas build --platform all --profile production",
    "submit:production": "eas submit --platform all --profile production",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "lint": "oxlint",
    "typecheck": "node ../../scripts/compile-typescript.cjs --noEmit"
  },
  "private": true
}
