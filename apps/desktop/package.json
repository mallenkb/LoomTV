{
  "name": "loom-media-server-desktop",
  "productName": "LoomTV",
  "version": "2.0.34",
  "description": "A local media server for your movie and TV show collection",
  "main": ".vite/build/main.js",
  "packageManager": "pnpm@12.6.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mallenkb/LoomTV.git"
  },
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.cjs",
    "prestart": "node scripts/enforce-pnpm.cjs && node scripts/fetch-fpcalc.cjs && node scripts/fetch-native-runtimes.cjs",
    "prestart:built": "node scripts/fetch-fpcalc.cjs",
    "prebuild": "node scripts/enforce-pnpm.cjs",
    "prepackage": "node scripts/enforce-pnpm.cjs && node scripts/fetch-fpcalc.cjs && node scripts/fetch-native-runtimes.cjs --required && node scripts/stage-native-runtimes.cjs --required",
    "premake": "node scripts/enforce-pnpm.cjs && node scripts/fetch-fpcalc.cjs && node scripts/fetch-native-runtimes.cjs --required && node scripts/stage-native-runtimes.cjs --required",
    "predist": "node scripts/enforce-pnpm.cjs && node scripts/fetch-fpcalc.cjs && node scripts/fetch-native-runtimes.cjs --required && node scripts/stage-native-runtimes.cjs --required",
    "prepublish": "node scripts/enforce-pnpm.cjs && node scripts/fetch-fpcalc.cjs && node scripts/fetch-native-runtimes.cjs --required && node scripts/stage-native-runtimes.cjs --required",
    "prerelease": "node scripts/enforce-pnpm.cjs && node scripts/fetch-fpcalc.cjs && node scripts/fetch-native-runtimes.cjs --required && node scripts/stage-native-runtimes.cjs --required",
    "prelint": "node scripts/enforce-pnpm.cjs",
    "start": "node scripts/run-electron-forge.cjs start",
    "start:built": "corepack pnpm run build && node scripts/run-built-app.cjs",
    "clean:out": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "clean:build": "node -e \"const fs=require('fs'); for (const p of ['out', '.vite']) fs.rmSync(p, { recursive: true, force: true })\"",
    "build:main": "vp build --config vite.main.config.ts && node scripts/verify-production-main.cjs",
    "build:preload": "vp build --config vite.preload.config.ts",
    "build:renderer": "vp build --config vite.renderer.config.ts",
    "build": "corepack pnpm run clean:build && corepack pnpm run build:main && corepack pnpm run build:preload && corepack pnpm run build:renderer",
    "package": "corepack pnpm run clean:out && node scripts/run-electron-forge.cjs package",
    "make": "corepack pnpm run clean:out && node scripts/run-electron-forge.cjs make",
    "make:all": "corepack pnpm run clean:out && node scripts/run-electron-forge.cjs make --platform=darwin --arch=arm64 && node scripts/run-electron-forge.cjs make --platform=win32 --arch=x64 && node scripts/run-electron-forge.cjs make --platform=linux --arch=x64",
    "verify:runtime": "node scripts/verify-packaged-runtime.cjs",
    "audit:prod": "node ../../scripts/audit-production.cjs",
    "dist": "corepack pnpm run build && electron-builder --publish=never",
    "dist:dir": "corepack pnpm run build && electron-builder --dir --publish=never",
    "dist:adhoc": "corepack pnpm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir --publish=never && bash scripts/sign-mac-adhoc.sh",
    "verify:mac-release": "bash scripts/verify-mac-release.sh",
    "verify:windows-release": "pwsh -NoProfile -File scripts/verify-windows-release.ps1",
    "typecheck": "node ../../scripts/compile-typescript.cjs --noEmit -p tsconfig.json && node ../../scripts/compile-typescript.cjs --noEmit -p tsconfig.node.json",
    "lint": "oxlint && oxlint -c .oxlintrc.promises.json src",
    "lint:promises": "oxlint -c .oxlintrc.promises.json src",
    "pretest": "cargo build --locked --release --manifest-path native/scanner/Cargo.toml",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.ts",
    "check:performance-budgets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-performance-budgets.ts",
    "scanner:build": "node scripts/build-scanner.cjs",
    "runtimes:fetch": "node scripts/fetch-native-runtimes.cjs",
    "libmpv:bundle": "node scripts/bundle-libmpv.cjs",
    "scanner:test": "cargo test --locked --release --manifest-path native/scanner/Cargo.toml && cargo build --locked --release --manifest-path native/scanner/Cargo.toml && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/scanner*.test.ts"
  },
  "keywords": [],
  "author": "LoomTV",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-rpm": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/asar": "4.3.1",
    "@electron/fuses": "2.1.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "oxlint": "catalog:",
    "sucrase": "3.35.1",
    "typescript": "catalog:",
    "tsrs": "catalog:"
  },
  "dependencies": {
    "@loom-media-server/lan-protocol": "workspace:*",
    "@loom-media-server/media-core": "workspace:*",
    "@loom-media-server/stremio-adapter": "workspace:*",
    "@loom-media-server/transcode-capabilities": "workspace:*",
    "@loom-media-server/video-migration": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-virtual": "3.14.21",
    "better-sqlite3": "13.0.3",
    "bonjour-service": "1.4.4",
    "clsx": "2.1.1",
    "electron-squirrel-startup": "1.0.1",
    "electron-updater": "6.8.9",
    "hls.js": "1.7.3",
    "koffi": "3.3.3",
    "loom-media-server-headless": "workspace:*",
    "lucide-react": "1.59.0",
    "motion": "14.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "webtorrent": "3.0.21",
    "zod": "catalog:"
  },
  "build": {
    "copyright": "Copyright \u00a9 2026 LoomTV",
    "appId": "com.mallenkb.loommediaserver",
    "productName": "LoomTV",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "afterSign": "scripts/after-sign.cjs",
    "afterPack": "scripts/ensure-update-config.cjs",
    "npmRebuild": false,
    "electronLanguages": [
      "en"
    ],
    "artifactBuildCompleted": "scripts/prepare-mac-update-archive.cjs",
    "directories": {
      "output": "out/builder"
    },
    "files": [
      ".vite/build/**/*",
      ".vite/renderer/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/better-sqlite3/build/**",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/src/**",
      "!node_modules/better-sqlite3/binding.gyp",
      "!node_modules/better-sqlite3/prebuilds/!(${platform}-${arch}.node)",
      "!node_modules/hls.js/!(package.json|dist)",
      "!node_modules/hls.js/!(package.json|dist)/**",
      "!node_modules/hls.js/dist/!(hls.min.js)",
      "!node_modules/lucide-react/**",
      "!node_modules/@phosphor-icons/**",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/scheduler/**",
      "!node_modules/framer-motion/**",
      "!node_modules/motion/**",
      "!node_modules/motion-dom/**",
      "!node_modules/motion-utils/**",
      "!node_modules/@tanstack/**",
      "!node_modules/seroval/**",
      "!node_modules/seroval-plugins/**",
      "!node_modules/cookie-es/**",
      "!node_modules/tailwind-merge/**",
      "!node_modules/clsx/**",
      "!node_modules/node-addon-api/**"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "resources/licenses",
        "to": "licenses"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/icon.icns",
        "to": "icon.icns"
      },
      {
        "from": "resources/trayIcon.png",
        "to": "trayIcon.png"
      },
      {
        "from": "resources/trayIcon@2x.png",
        "to": "trayIcon@2x.png"
      },
      {
        "from": "../server/src/web-app.html",
        "to": "web-app.html"
      },
      {
        "from": "../server/src/setup.html",
        "to": "setup.html"
      },
      {
        "from": "src/headless/admin.html",
        "to": "admin.html"
      },
      {
        "from": "src/headless/lucide-icons.svg",
        "to": "lucide-icons.svg"
      },
      {
        "from": "resources/libvlc/NOTICE.md",
        "to": "libvlc/NOTICE.md"
      },
      {
        "from": "resources/mpv/NOTICE.md",
        "to": "mpv/NOTICE.md"
      },
      {
        "from": "resources/mpv/README.md",
        "to": "mpv/README.md"
      },
      {
        "from": "resources/mpv/lib",
        "to": "mpv/lib"
      },
      {
        "from": "resources/ffmpeg/runtime-provenance.json",
        "to": "ffmpeg/runtime-provenance.json"
      },
      {
        "from": "resources/ffmpeg/NOTICE.md",
        "to": "ffmpeg/NOTICE.md"
      },
      {
        "from": "resources/ffmpeg/COPYING.GPLv3.txt",
        "to": "ffmpeg/COPYING.GPLv3.txt"
      },
      {
        "from": "resources/fpcalc/NOTICE.md",
        "to": "fpcalc/NOTICE.md"
      },
      {
        "from": "resources/DICEBEAR_GLYPHS_LICENSE.md",
        "to": "DICEBEAR_GLYPHS_LICENSE.md"
      }
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "asarUnpack": [
      "**/node_modules/@img/**/*",
      "**/*.node",
      "**/ffmpeg*",
      "**/ffprobe*",
      "**/libvlc/**/*",
      "**/mpv/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "mallenkb",
        "repo": "LoomTV",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "resources/icon.icns",
      "extraResources": [
        {
          "from": "resources/libvlc/darwin/${arch}/VLC.app/Contents/MacOS/lib",
          "to": "libvlc/darwin/${arch}/lib"
        },
        {
          "from": "resources/libvlc/darwin/${arch}/VLC.app/Contents/MacOS/plugins",
          "to": "libvlc/darwin/${arch}/plugins",
          "filter": [
            "**/*",
            "!libmacosx_plugin.dylib"
          ]
        },
        {
          "from": "resources/libvlc/darwin/${arch}/VLC.app/Contents/MacOS/share",
          "to": "libvlc/darwin/${arch}/share"
        },
        {
          "from": "resources/libvlc/darwin/${arch}/packaged-runtime-manifest.json",
          "to": "libvlc/darwin/${arch}/runtime-manifest.json"
        },
        {
          "from": "resources/ffmpeg/mac",
          "to": "ffmpeg/mac"
        },
        {
          "from": "resources/fpcalc/mac",
          "to": "fpcalc/mac"
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "extraResources": [
        {
          "from": "resources/libvlc/win32/x64",
          "to": "libvlc/win32/x64",
          "filter": [
            "**/*",
            "!runtime-manifest.json",
            "!.loomtv-native-runtime-staging.json"
          ]
        },
        {
          "from": "resources/libvlc/win32/x64/runtime-manifest.json",
          "to": "libvlc/win32/x64/runtime-manifest.json"
        },
        {
          "from": "resources/ffmpeg/win",
          "to": "ffmpeg/win"
        },
        {
          "from": "resources/fpcalc/win",
          "to": "fpcalc/win"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "AudioVideo",
      "maintainer": "LoomTV <releases@loomtv.local>",
      "extraResources": [
        {
          "from": "resources/ffmpeg/linux",
          "to": "ffmpeg/linux"
        },
        {
          "from": "resources/fpcalc/linux",
          "to": "fpcalc/linux"
        }
      ],
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    }
  }
}
