{
  "name": "loom-media-server-desktop",
  "productName": "LoomTV",
  "version": "1.0.84",
  "description": "A local media server for your movie and TV show collection",
  "main": ".vite/build/main.js",
  "packageManager": "pnpm@11.17.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mallenkb/LoomTV.git"
  },
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.cjs",
    "prestart": "node scripts/enforce-pnpm.cjs && electron-rebuild -f -w better-sqlite3",
    "prebuild": "node scripts/enforce-pnpm.cjs",
    "prepackage": "node scripts/enforce-pnpm.cjs && node scripts/fetch-fpcalc.cjs",
    "premake": "node scripts/enforce-pnpm.cjs && node scripts/fetch-fpcalc.cjs",
    "predist": "node scripts/enforce-pnpm.cjs && node scripts/fetch-fpcalc.cjs",
    "prepublish": "node scripts/enforce-pnpm.cjs && node scripts/fetch-fpcalc.cjs",
    "prerelease": "node scripts/enforce-pnpm.cjs && node scripts/fetch-fpcalc.cjs",
    "prelint": "node scripts/enforce-pnpm.cjs",
    "start": "node scripts/run-electron-forge.cjs start",
    "clean:out": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "clean:build": "node -e \"const fs=require('fs'); for (const p of ['out', '.vite']) fs.rmSync(p, { recursive: true, force: true })\"",
    "rebuild:natives": "electron-rebuild -f -w better-sqlite3",
    "build:main": "vp build --config vite.main.config.ts",
    "build:preload": "vp build --config vite.preload.config.ts",
    "build:renderer": "vp build --config vite.renderer.config.ts",
    "build": "corepack pnpm run clean:build && corepack pnpm run build:main && corepack pnpm run build:preload && corepack pnpm run build:renderer",
    "package": "corepack pnpm run rebuild:natives && corepack pnpm run clean:out && node scripts/run-electron-forge.cjs package",
    "make": "corepack pnpm run rebuild:natives && corepack pnpm run clean:out && node scripts/run-electron-forge.cjs make",
    "make:all": "corepack pnpm run rebuild:natives && corepack pnpm run clean:out && node scripts/run-electron-forge.cjs make --platform=darwin --arch=arm64 && node scripts/run-electron-forge.cjs make --platform=win32 --arch=x64 && node scripts/run-electron-forge.cjs make --platform=linux --arch=x64",
    "verify:runtime": "node scripts/verify-packaged-runtime.cjs",
    "audit:prod": "node scripts/audit-production.cjs",
    "publish": "corepack pnpm run release",
    "dist": "corepack pnpm run rebuild:natives && corepack pnpm run build && electron-builder --publish=never",
    "dist:dir": "corepack pnpm run rebuild:natives && corepack pnpm run build && electron-builder --dir --publish=never",
    "dist:adhoc": "corepack pnpm run rebuild:natives && corepack pnpm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir --publish=never && bash scripts/sign-mac-adhoc.sh",
    "verify:mac-release": "bash scripts/verify-mac-release.sh",
    "release": "corepack pnpm run rebuild:natives && corepack pnpm run build && electron-builder --publish=always",
    "release:all-platforms": "corepack pnpm run release",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint --ext .ts,.tsx .",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.ts"
  },
  "keywords": [],
  "author": "malllenkb",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "7.11.1",
    "@electron-forge/maker-deb": "7.11.1",
    "@electron-forge/maker-dmg": "7.11.1",
    "@electron-forge/maker-rpm": "7.11.1",
    "@electron-forge/maker-squirrel": "7.11.1",
    "@electron-forge/maker-zip": "7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.1",
    "@electron-forge/plugin-fuses": "7.11.1",
    "@electron-forge/plugin-vite": "7.11.1",
    "@electron-forge/shared-types": "7.11.1",
    "@electron/asar": "4.2.0",
    "@electron/fuses": "1.8.0",
    "@electron/rebuild": "4.0.4",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.2.4",
    "@types/better-sqlite3": "7.6.13",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "electron": "43.1.1",
    "electron-builder": "26.8.1",
    "eslint": "10.7.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "pnpm": "11.17.0",
    "postcss": "8.5.14",
    "tailwindcss": "4.2.4",
    "typescript": "5.7.3",
    "typescript-eslint": "8.64.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "bonjour-service": "1.3.0",
    "clsx": "2.1.1",
    "electron-squirrel-startup": "1.0.1",
    "electron-updater": "6.8.9",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "hls.js": "1.6.16",
    "lucide-react": "1.14.0",
    "motion": "12.38.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router-dom": "7.18.1",
    "tailwind-merge": "3.5.0"
  },
  "build": {
    "appId": "com.mallenkb.loommediaserver",
    "productName": "LoomTV",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "afterSign": "scripts/after-sign.cjs",
    "afterPack": "scripts/ensure-update-config.cjs",
    "artifactBuildCompleted": "scripts/prepare-mac-update-archive.cjs",
    "directories": {
      "output": "out/builder"
    },
    "files": [
      ".vite/build/**/*",
      ".vite/renderer/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/icon.icns",
        "to": "icon.icns"
      },
      {
        "from": "resources/fpcalc/NOTICE.md",
        "to": "fpcalc/NOTICE.md"
      },
      {
        "from": "resources/DICEBEAR_GLYPHS_LICENSE.md",
        "to": "DICEBEAR_GLYPHS_LICENSE.md"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/ffmpeg*",
      "**/ffprobe*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "mallenkb",
        "repo": "LoomTV",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "resources/icon.icns",
      "extraResources": [
        {
          "from": "resources/ffmpeg/mac",
          "to": "ffmpeg/mac"
        },
        {
          "from": "resources/fpcalc/mac",
          "to": "fpcalc/mac"
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "extraResources": [
        {
          "from": "resources/ffmpeg/win",
          "to": "ffmpeg/win"
        },
        {
          "from": "resources/fpcalc/win",
          "to": "fpcalc/win"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "AudioVideo",
      "maintainer": "mallenkb <releases@loomtv.local>",
      "extraResources": [
        {
          "from": "resources/ffmpeg/linux",
          "to": "ffmpeg/linux"
        },
        {
          "from": "resources/fpcalc/linux",
          "to": "fpcalc/linux"
        }
      ],
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    }
  }
}
