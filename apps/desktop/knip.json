{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.ts",
    "src/preload.ts",
    "forge.config.ts",
    "vite.*.config.ts",
    "tests/*.test.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "tests/**/*.ts",
    "vite.*.config.ts"
  ],
  "ignoreDependencies": [
    "pnpm",
    "@eslint/js",
    "eslint-import-resolver-typescript",
    "eslint-plugin-import-x",
    "eslint-plugin-react-hooks",
    "globals",
    "typescript-eslint"
  ],
  "ignoreBinaries": [
    "file",
    "which",
    "networksetup",
    "ipconfig",
    "system_profiler",
    "netsh",
    "iwgetid",
    "nmcli",
    "iw",
    "ps"
  ]
}
