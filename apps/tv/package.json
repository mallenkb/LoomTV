{
  "name": "@loom-media-server/tv",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "main": "index.ts",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "../mobile/modules"
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "preandroid": "expo prebuild --platform android --no-install",
    "android": "expo run:android",
    "build:development": "eas build --platform android --profile development",
    "build:preview": "eas build --platform android --profile preview",
    "build:production": "eas build --platform android --profile production",
    "submit:production": "eas submit --platform android --profile production",
    "typecheck": "node ../../scripts/compile-typescript.cjs --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "verify:config": "node scripts/verify-tv-config.cjs",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "expo": "58.0.16",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.3",
    "expo-video": "58.0.12",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-zeroconf": "0.17.6",
    "expo-system-ui": "58.0.6"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "catalog:",
    "tsrs": "catalog:"
  }
}
