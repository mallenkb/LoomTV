{
  "name": "loomtv",
  "productName": "LoomTV",
  "version": "1.0.11",
  "description": "A local media server for your movie and TV show collection",
  "main": ".vite/build/main.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mallenkb/LoomTV.git"
  },
  "scripts": {
    "start": "electron-forge start",
    "clean:out": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "clean:build": "node -e \"const fs=require('fs'); for (const p of ['out', '.vite']) fs.rmSync(p, { recursive: true, force: true })\"",
    "rebuild:natives": "electron-rebuild -f -w better-sqlite3",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build": "npm run clean:build && npm run build:main && npm run build:preload && npm run build:renderer",
    "package": "npm run rebuild:natives && npm run clean:out && electron-forge package",
    "make": "npm run rebuild:natives && npm run clean:out && electron-forge make",
    "make:all": "npm run rebuild:natives && npm run clean:out && electron-forge make --platform=darwin --arch=arm64 && electron-forge make --platform=win32 --arch=x64 && electron-forge make --platform=linux --arch=x64",
    "verify:runtime": "node scripts/verify-packaged-runtime.cjs",
    "publish": "npm run release",
    "dist": "npm run rebuild:natives && npm run build && electron-builder --publish=never",
    "dist:dir": "npm run rebuild:natives && npm run build && electron-builder --dir --publish=never",
    "release": "npm run rebuild:natives && npm run build && electron-builder --publish=always",
    "release:all-platforms": "npm run release",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "keywords": [],
  "author": "malllenkb",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/shared-types": "^7.11.1",
    "@electron/asar": "^4.2.0",
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^18.19.130",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "41.5.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "typescript": "~4.5.4",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "hls.js": "^1.6.16",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "tailwind-merge": "^3.5.0"
  },
  "build": {
    "appId": "com.mallenkb.loomtv",
    "productName": "LoomTV",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "out/builder"
    },
    "files": [
      ".vite/build/**/*",
      ".vite/renderer/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "resources/mpv",
        "to": "mpv"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/icon.icns",
        "to": "icon.icns"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/ffmpeg*",
      "**/ffprobe*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "mallenkb",
        "repo": "LoomTV",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "resources/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "AudioVideo",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    }
  }
}
