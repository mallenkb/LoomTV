{
  "name": "loomtv",
  "productName": "LoomTV",
  "version": "1.0.10",
  "description": "A local media server for your movie and TV show collection",
  "main": ".vite/build/main.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mallenkb/LoomTV.git"
  },
  "scripts": {
    "start": "electron-forge start",
    "clean:out": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "rebuild:natives": "electron-rebuild -f -w better-sqlite3",
    "package": "npm run rebuild:natives && npm run clean:out && electron-forge package",
    "make": "npm run rebuild:natives && npm run clean:out && electron-forge make",
    "make:all": "npm run rebuild:natives && npm run clean:out && electron-forge make --platform=darwin --arch=arm64 && electron-forge make --platform=win32 --arch=x64 && electron-forge make --platform=linux --arch=x64",
    "verify:runtime": "node scripts/verify-packaged-runtime.cjs",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "keywords": [],
  "author": "malllenkb",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron-forge/shared-types": "^7.11.1",
    "@electron/asar": "^4.2.0",
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^18.19.130",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "41.5.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "typescript": "~4.5.4",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "hls.js": "^1.6.16",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "tailwind-merge": "^3.5.0"
  }
}
