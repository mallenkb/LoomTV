      "idPrefixes": ["example:"]
    },
    {
      "name": "stream",
      "types": ["movie"],
      "idPrefixes": ["example:"]
    },
    {
      "name": "subtitles",
      "types": ["movie"],
      "idPrefixes": ["example:"]
    }
  ],
  "types": ["movie"],
  "idPrefixes": ["example:"],
  "catalogs": [
    {
      "type": "movie",
      "id": "example-movies",
      "name": "Example Movies",
      "extra": [
        {
          "name": "search",
          "isRequired": false
        }
      ]
    }
  ],
  "behaviorHints": {
    "p2p": false
