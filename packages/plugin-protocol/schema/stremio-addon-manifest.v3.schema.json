{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loomtv.app/schemas/stremio-addon-manifest.v3.schema.json",
  "title": "LoomTV Stremio-compatible Add-on Manifest v3 subset",
  "description": "The response-normalized Stremio manifest subset accepted by LoomTV from a public HTTPS transport. Runtime validation rejects local/private hosts, credentials, fragments, and manifests without at least one Loom-supported resource. Unsupported resources and unsafe optional artwork are ignored with explicit compatibility warnings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "name",
    "description",
    "resources",
    "types",
    "catalogs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/token"
          },
          {
            "$ref": "#/$defs/resourceObject"
          }
        ]
      }
    },
    "types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "idPrefixes": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "catalogs": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/catalog"
      }
    },
    "logo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Optional artwork metadata. Runtime normalization retains only public HTTPS URLs."
    },
    "background": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Optional artwork metadata. Runtime normalization retains only public HTTPS URLs."
    },
    "contactEmail": {
      "type": "string",
      "minLength": 1,
      "maxLength": 254
    },
    "behaviorHints": {
      "$ref": "#/$defs/behaviorHints"
    },
    "addonCatalogs": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/catalog"
      },
      "description": "Accepted for official manifest compatibility but not imported as LoomTV providers."
    },
    "config": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/config"
      }
    },
    "stremioAddonsConfig": {
      "type": "object",
      "description": "Accepted for Stremio Addons compatibility but ignored by LoomTV."
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "resourceObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "#/$defs/token"
        },
        "types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "idPrefixes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "name"],
      "properties": {
        "type": {
          "$ref": "#/$defs/token"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "extra": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/extra"
          }
        },
        "genres": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "extraSupported": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "extraRequired": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/token"
          }
        }
      }
    },
    "extra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "#/$defs/token"
        },
        "isRequired": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "optionsLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "behaviorHints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adult": {
          "type": "boolean"
        },
        "p2p": {
          "type": "boolean"
        },
        "configurable": {
          "type": "boolean"
        },
        "configurationRequired": {
          "type": "boolean"
        },
        "newEpisodeNotifications": {
          "type": "boolean"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type"],
      "properties": {
        "key": {
          "$ref": "#/$defs/token"
        },
        "type": {
          "enum": ["text", "number", "password", "checkbox", "select", "boolean", "string"]
        },
        "default": {
          "type": ["string", "number", "boolean"],
          "maxLength": 512
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "options": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": {
          "type": "boolean"
        }
      }
    }
  }
}
