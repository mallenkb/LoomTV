{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loomtv.app/schemas/plugin-manifest.v1.schema.json",
  "title": "LoomTV Plugin Manifest v1",
  "description": "A declaration-only, capability-scoped LoomTV plugin manifest. Runtime validation also enforces the supported Loom API range grammar and HTTPS homepage rule.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "name",
    "version",
    "loomApi",
    "capabilities"
  ],
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$",
      "description": "Lowercase reverse-DNS plugin identity."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "description": "Plugin release version in SemVer form."
    },
    "loomApi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["range"],
      "properties": {
        "range": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Stable SemVer comparator/caret/tilde/x-range accepted by Loom's v1 validator, for example >=1.0.0 <2.0.0."
        }
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "homepage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https://"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/metadataCatalogCapability"
          },
          {
            "$ref": "#/$defs/subtitleProviderCapability"
          },
          {
            "$ref": "#/$defs/playbackProviderCapability"
          }
        ]
      }
    }
  },
  "$defs": {
    "metadataCatalogCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "apiVersion"],
      "properties": {
        "type": {
          "const": "metadata.catalog"
        },
        "apiVersion": {
          "const": 1
        }
      }
    },
    "subtitleProviderCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "apiVersion"],
      "properties": {
        "type": {
          "const": "subtitle.provider"
        },
        "apiVersion": {
          "const": 1
        }
      }
    },
    "playbackProviderCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "apiVersion", "hooks"],
      "properties": {
        "type": {
          "const": "playback.provider"
        },
        "apiVersion": {
          "const": 1
        },
        "hooks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["resolve-source", "list-variants"]
          }
        }
      }
    }
  }
}
