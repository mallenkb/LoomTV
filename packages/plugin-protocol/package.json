{
  "name": "@loom-media-server/plugin-protocol",
  "version": "1.0.0",
  "description": "Versioned, capability-scoped LoomTV plugin manifest contracts and boundary validation",
  "private": true,
  "type": "module",
  "main": "src/index.mjs",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.mjs"
    },
    "./schema": "./schema/plugin-manifest.v1.schema.json",
    "./downstream-schema": "./schema/plugin-downstream.v2.schema.json",
    "./downstream-schema-v2": "./schema/plugin-downstream.v2.schema.json",
    "./identity": {
      "types": "./src/identity.ts",
      "import": "./src/identity.mjs"
    },
    "./marketplace": {
      "types": "./src/marketplace.ts",
      "import": "./src/marketplace.mjs"
    },
    "./runtime-lifecycle": {
      "types": "./src/runtime-lifecycle.ts",
      "import": "./src/runtime-lifecycle.mjs"
    },
    "./signed-bytes": {
      "types": "./src/signed-bytes.ts",
      "import": "./src/signed-bytes.mjs"
    },
    "./stremio-schema": "./schema/stremio-addon-manifest.v3.schema.json",
    "./stremio-adapter": {
      "types": "./src/stremio-adapter.ts",
      "import": "./src/stremio-adapter.mjs"
    }
  },
  "files": [
    "src",
    "dist",
    "schema",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "5.7.3"
  }
}
