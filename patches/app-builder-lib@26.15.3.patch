+        headers,
+        signal: AbortSignal.timeout(30000),
+    });
+    if (!releaseResponse.ok) throw new Error(`Could not inspect ${repo} release ${tag}: HTTP ${releaseResponse.status}.`);
+    const release = await releaseResponse.json();
