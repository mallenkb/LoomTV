{
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["vite.config.ts", "vite.main.config.ts", "vite.preload.config.ts", "vite.renderer.config.ts", "forge.config.ts"]
}
