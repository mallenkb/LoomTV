# Bind on all interfaces so a browser or TV on the LAN can reach LoomTV.
HOST=0.0.0.0
PORT=3847

# Keep these on local storage.  The media directory can be a host-mounted
# SMB/NFS path; LoomTV never stores NAS credentials here.
DATA_DIR=/var/lib/loomtv
CACHE_DIR=/var/cache/loomtv
MEDIA_DIR=/srv/loomtv-media

# Optional metadata/provider values are configured by the web administration
# surface once it is available.  Do not commit secrets to this file.
# TZ=UTC
